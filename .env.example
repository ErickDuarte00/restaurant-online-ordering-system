# ========================================
# Configuración de Django Backend
# ========================================
DEBUG=True
DJANGO_SECRET_KEY=django-insecure-change-this-in-production-random-key-12345
DJANGO_ALLOWED_HOSTS=*
DJANGO_LOGLEVEL=info

# ========================================
# Configuración de Base de Datos PostgreSQL
# ========================================
DATABASE_ENGINE=postgresql
DATABASE_NAME=restaurant_db
DATABASE_USERNAME=restaurant_user
DATABASE_PASSWORD=restaurant_password
DATABASE_HOST=db
DATABASE_PORT=5432

# ========================================
# Configuración de Stripe (Pagos)
# ========================================
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

